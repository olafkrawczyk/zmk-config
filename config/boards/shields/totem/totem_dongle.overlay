/*
 * TOTEM dongle part (Prospector): central with no keys of its own.
 * Uses the mock kscan driver; the matrix transform must match totem.dtsi
 * exactly (same node name and map) so positions from the halves map correctly.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/* Touchscreen (CST816S, on the Waveshare 1.69" Touch LCD) for swipe
 * navigation between status screens. Requires the TP_* wires soldered:
 * TP_SDA->D4, TP_SCL->D5, TP_RST->D0, TP_IRQ->D1.
 * NOTE: the nodes are defined here (not in the module) because dtc resolves
 * &label references in overlay concatenation order, and this overlay comes
 * before the prospector_adapter overlays. */
&i2c1 {
    cst816s: cst816s@15 {
        compatible = "hynitron,cst816s";
        status = "okay";
        reg = <0x15>;
        irq-gpios = <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        rst-gpios = <&xiao_d 0 GPIO_ACTIVE_LOW>;
    };
};

/ {
    /* Feeds CST816S touch events into LVGL as a pointer input device.
     * invert-x/invert-y: the CST816S coordinate frame is rotated 180°
     * relative to the ST7789 display in this mounting. */
    lvgl_pointer_input: lvgl_pointer_input {
        compatible = "zephyr,lvgl-pointer-input";
        input = <&cst816s>;
        invert-x;
        invert-y;
    };

    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix_transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };
};
