/*
 * TOTEM dongle part (Prospector): central with no keys of its own.
 * Uses the mock kscan driver; the matrix transform must match totem.dtsi
 * exactly (same node name and map) so positions from the halves map correctly.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/* Touchscreen (CST816S, on the Waveshare 1.69" Touch LCD) for swipe
 * navigation between status screens. Requires the TP_* wires soldered:
 * TP_SDA->D4, TP_SCL->D5, TP_RST->D0, TP_IRQ->D1. */
&cst816s {
    status = "okay";
};

&lvgl_pointer_input {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix_transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };
};
